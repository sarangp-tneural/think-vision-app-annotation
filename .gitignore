# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# IDE and editors
.idea/
.vscode/
*.swp

# Dependencies
node_modules/
/.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Next.js
/.next/
/out/
next-env.d.ts
*.tsbuildinfo

# Production builds
build/
dist/

# Environment files
.env
.env.*
!.env.example

# Secrets and credentials
*token.json*
*credentials.json*
*.pem
*.key
memory/test_credentials.md

# Logs and debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dump.rdb

# System files
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# ML models and training outputs (YOLO weights are auto-downloaded by ultralytics)
*.pt
*.pth
*.onnx
runs/

# Development tools
chainlit.md
.chainlit
.ipynb_checkpoints/
.ac

# Deployment
.vercel

# Archive files and large assets
*.zip
*.tar.gz
*.tar
*.tgz
*.pack
*.deb
*.dylib

# Build caches
.cache/
